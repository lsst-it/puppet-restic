{
  "name": "syseleven-restic",
  "version": "2.8.1",
  "author": "Mike Fröhner @ SysEleven GmbH",
  "summary": "Puppet module to configure Restic systemd service to backup/forget/restore data.",
  "license": "Apache-2.0",
  "source": "https://github.com/syseleven/puppet-restic.git",
  "project_page": "https://github.com/syseleven/puppet-restic.git",
  "issues_url": "https://github.com/syseleven/puppet-restic/issues",
  "dependencies": [
    { "name": "puppet/systemd", "version_requirement": ">= 3.10.0" },
    { "name": "puppetlabs/concat", "version_requirement": ">= 7.4.0" },
    { "name": "puppetlabs/stdlib", "version_requirement": ">= 8.2.0" }
  ],
  "operatingsystem_support": [
    { "operatingsystem": "Ubuntu", "operatingsystemrelease": ["20.04", "22.04"] },
    { "operatingsystem": "RedHat", "operatingsystemrelease": ["9"] },
    { "operatingsystem": "AlmaLinux", "operatingsystemrelease": ["9"] }
  ],
  "requirements": [
    { "name": "puppet", "version_requirement": ">= 6.0.0 < 9.0.0" }
  ]
}
